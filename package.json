{
  "name": "offline-puzzle-pirates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p packages/sim/tsconfig.json && tsc -p packages/harness/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "deps": "node tools/check-sim-deps.ts",
    "imports": "node tools/check-sim-imports.ts",
    "harness": "node packages/harness/bin/pp-harness.ts",
    "check": "npm run deps && npm run imports && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
